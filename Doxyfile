ALIASES               += "luaparam{2}=\param \1 \2" \
                         "luareturn{1}=\return \1"
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
CPP_CLI_SUPPORT        = NO
CREATE_SUBDIRS         = YES
ENABLE_PREPROCESSING   = YES
EXCLUDE                = extern/ \
                         build/  \
                         .cache/
EXCLUDE_PATTERNS       = */extern/* \
                         */build/*
EXTRACT_ALL            = YES
EXTRACT_ANON_NSPACES   = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
FILE_PATTERNS          = *.cpp \
                         *.h   \
                         *.hpp \
                         *.lua \
                         *.md
FILTER_PATTERNS        = *.lua=lua2dox_filter
FULL_PATH_NAMES        = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
HTML_COLORSTYLE        = DARK
HTML_DYNAMIC_SECTIONS  = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES
INCLUDE_GRAPH          = YES
INLINE_SOURCES         = NO
INPUT                  = src/ \
                         lua/ \
                         README.md
INPUT_ENCODING         = UTF-8
JAVADOC_AUTOBRIEF      = YES
MACRO_EXPANSION        = YES
MARKDOWN_SUPPORT       = YES
NUM_PROC_THREADS       = 0
OPTIMIZE_OUTPUT_FOR_C  = NO
OUTPUT_DIRECTORY       = docs/
PREDEFINED             = APICALL=              \
                         EXPORT=               \
                         HYPRLAND_API_VERSION=
PROJECT_BRIEF          = "LuaCATS annotations and Lua scripting addon for Hyprland 0.55+"
PROJECT_LOGO           = assets/logo.png
PROJECT_NAME           = "Hyprlua"
PROJECT_NUMBER         = 0.1.0
QT_AUTOBRIEF           = NO
QUIET                  = YES
RECURSIVE              = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
SHOW_USED_FILES        = YES
SORT_BRIEF_DOCS        = YES
SORT_GROUP_NAMES       = YES
SORT_MEMBER_DOCS       = YES
SORT_MEMBERS_CTORS_1ST = YES
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
STRIP_FROM_PATH        = src/ lua/
TAB_SIZE               = 4
TYPEDEF_HIDES_STRUCT   = NO
USE_MDFILE_AS_MAINPAGE = README.md
VERBATIM_HEADERS       = YES
WARN_AS_ERROR          = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_LOGFILE           = docs/doxygen-warnings.log
WARN_NO_PARAMDOC       = YES
